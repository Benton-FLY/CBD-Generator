import fs from 'node:fs/promises';
import {applyManagerFloors} from '../src/comparison/managerPricing';
import {comparisonModel} from '../src/comparison/model';
const state=JSON.parse(await fs.readFile('reports/manager-state.json','utf8'));
for(const pair of state.styleMatches){const {reference,comparison,clusters}=comparisonModel(state,pair),stats={matched:0,cost:0,usage:0,both:0,newOnly:0,review:0,replacements:[] as string[],holds:[] as unknown[]};for(const cluster of clusters){const old=(reference?.materials||[]).filter(row=>cluster.referenceRowIds.includes(row.id)),ids=cluster.currentRowIds??(cluster.currentRowId?[cluster.currentRowId]:[]),cur=(comparison?.materials||[]).filter(row=>ids.includes(row.id)),decision=applyManagerFloors(old,cur,cluster);if(decision.status==='matched')stats.matched++;if(decision.status==='current-only')stats.newOnly++;if(decision.status==='needs-review'||decision.status==='reference-only')stats.review++;if(decision.unitCostFloorApplied)stats.cost++;if(decision.usageFloorApplied)stats.usage++;if(decision.unitCostFloorApplied&&decision.usageFloorApplied)stats.both++;if(old[0]&&cur[0]&&old[0].material!==cur[0].material)stats.replacements.push(`${old[0].material} → ${cur[0].material}`);if(decision.unitCostFloorApplied||decision.usageFloorApplied)stats.holds.push({material:cur[0]?.material,cost:decision.unitCostFloorApplied?[decision.sourceNewUnitCost,decision.appliedNewUnitCost]:undefined,usage:decision.usageFloorApplied?[decision.sourceNewUsage,decision.appliedNewUsage]:undefined});}console.log(JSON.stringify({style:comparison?.styleName||reference?.styleName,...stats,sourceTotal:comparison?.summary.totalMaterialCost},null,2));}
